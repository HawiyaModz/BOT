<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "JayPay" %></title>
  <meta name="description" content="Platform Node.js modern dengan dashboard dan berbagai fitur.">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="navbar">
    <a class="brand" href="/">JayPay<span>Hub</span></a>
    <button class="menu-btn" onclick="toggleMenu()">☰</button>
    <nav id="nav">
      <a href="/">Beranda</a>
      <a href="/features">Fitur</a>
      <a href="/faq">FAQ</a>
      <% if (user) { %>
        <a class="nav-user" href="/dashboard">Dashboard</a><a class="nav-user" href="/whatsapp">WhatsApp</a>
      <% } else { %>
        <a href="/login">Masuk</a>
        <a class="btn small" href="/register">Daftar</a>
      <% } %>
      <button class="theme-btn" onclick="toggleTheme()" aria-label="Tema">◐</button>
    </nav>
  </header>