<%- include("partials/header", {title: "WhatsApp — JayPay", user}) %>
<main class="page">
  <div class="page-title">
    <span class="eyebrow">WHATSAPP BOT</span>
    <h1>Hubungkan WhatsApp ke JayPay.</h1>
    <p>Contoh integrasi QR scan atau kode pairing. Setelah terhubung, bot dapat merespons perintah sederhana.</p>
  </div>

  <div class="wa-grid">
    <section class="panel wa-card">
      <div class="panel-title"><h2>Hubungkan</h2><span id="wa-status"><%= wa.status %></span></div>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="post" action="/whatsapp/connect">
        <label>Nomor WhatsApp
          <input name="phone" inputmode="numeric" placeholder="628xxxxxxxxxx" required>
        </label>
        <button class="btn full" type="submit">Buat Kode Pairing</button>
      </form>
      <p class="hint">Gunakan format internasional tanpa tanda + atau spasi. Untuk QR, jalankan koneksi dan tunggu QR tersedia.</p>
    </section>

    <section class="panel wa-card center">
      <div class="panel-title"><h2>Kode / QR</h2><span>Realtime</span></div>
      <div id="pairing">
        <% if (wa.pairingCode) { %>
          <div class="pair-code"><%= wa.pairingCode %></div>
          <p>WhatsApp → Perangkat tertaut → Tautkan dengan nomor telepon.</p>
        <% } else if (wa.qr) { %>
          <img class="qr" src="<%= wa.qr %>" alt="QR WhatsApp">
          <p>Scan QR menggunakan WhatsApp.</p>
        <% } else { %>
          <div class="empty-wa">Kode/QR akan muncul di sini.</div>
        <% } %>
      </div>
    </section>
  </div>

  <section class="panel commands">
    <div class="panel-title"><h2>Contoh fitur bot</h2><span>aktif setelah terhubung</span></div>
    <div class="command"><code>!ping</code><span>Bot membalas Pong.</span></div>
    <div class="command"><code>!menu</code><span>Bot mengirim daftar menu.</span></div>
  </section>
</main>
<script>
async function refreshWA(){
  try{
    const d=await fetch("/api/whatsapp/status").then(r=>r.json());
    document.getElementById("wa-status").textContent=d.status;
    const box=document.getElementById("pairing");
    if(d.pairingCode){
      box.innerHTML='<div class="pair-code">'+d.pairingCode+'</div><p>WhatsApp → Perangkat tertaut → Tautkan dengan nomor telepon.</p>';
    }else if(d.qr){
      box.innerHTML='<img class="qr" src="'+d.qr+'" alt="QR WhatsApp"><p>Scan QR menggunakan WhatsApp.</p>';
    }
  }catch(e){}
}
setInterval(refreshWA,3000);
</script>
<%- include("partials/footer") %>